# Copiar este archivo a .env y completar con valores reales.
# El archivo .env nunca debe subirse al repositorio.

# ---- PostgreSQL ----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme
POSTGRES_DB=n8n
CLINICA_DB_NAME=clinica
POSTGRES_PORT=5432

# ---- n8n ----
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
# Generar una clave estable con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Caracas

# ---- Evolution API ----
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
# Clave que Evolution API exige en el header apikey para todas las llamadas
EVOLUTION_API_KEY=changeme

# ---- Anthropic (Claude Haiku) ----
# Se usa dentro del nodo HTTP Request / credencial de Anthropic en n8n,
# no la lee docker-compose directamente. Ver README para dónde configurarla.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
